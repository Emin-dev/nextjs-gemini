{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "**",
      "!!**/node_modules",
      "!!**/.next",
      "!!**/out",
      "!!**/build",
      "!!**/test-results",
      "!!**/playwright-report",
      "!**/next-env.d.ts"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "includes": [
      "**/*.{js,jsx,cjs,mjs,ts,tsx}"
    ],
    "rules": {
      "preset": "recommended",
      "style": {
        "noCommonJs": "error"
      },
      "correctness": {
        "noNextAsyncClientComponent": "error",
        "noBeforeInteractiveScriptOutsideDocument": "error"
      },
      "performance": {
        "noSyncScripts": "warn"
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  }
}
